s="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S11_06_ga_al_dia.wav"/></asset><asset id="a21" name="S11_07_stop_central" start="0s" duration="247/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S11_07_stop_central.wav"/></asset><asset id="a22" name="S11_08_start_central" start="0s" duration="229/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S11_08_start_central.wav"/></asset><asset id="a23" name="S12" start="0s" duration="114/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S12.wav"/></asset><asset id="a24" name="S13" start="0s" duration="699/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S13.wav"/></asset><asset id="a25" name="S14" start="0s" duration="583/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S14.wav"/></asset><asset id="a26" name="S15" start="0s" duration="555/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S15.wav"/></asset><asset id="a27" name="S16" start="0s" duration="356/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S16.wav"/></asset><asset id="a28" name="S01_Apertura" start="0s" duration="480/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S01_Apertura.mp4"/></asset><asset id="a29" name="S02_CARA_Camilo" start="0s" duration="837/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/caras/S02_CARA_Camilo.mp4"/></asset><asset id="a30" name="S03_Arquitectura_en_estrella" start="0s" duration="1230/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S03_Arquitectura_en_estrella.mp4"/></asset><asset id="a31" name="S04_CARA_Johen" start="0s" duration="216/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/caras/S04_CARA_Johen.mp4"/></asset><asset id="a32" name="S05_Bandeja_de_salida" start="0s" duration="660/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S05_Bandeja_de_salida.mp4"/></asset><asset id="a33" name="S06_Reloj_de_Lamport" start="0s" duration="990/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S06_Reloj_de_Lamport.mp4"/></asset><asset id="a34" name="S07_Idempotencia" start="0s" duration="570/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S07_Idempotencia.mp4"/></asset><asset id="a35" name="S08_CARA_Daniel" start="0s" duration="318/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/caras/S08_CARA_Daniel.mp4"/></asset><asset id="a36" name="S09_Reintentos_con_espera_exponencial" start="0s" duration="960/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S09_Reintentos_con_espera_exponencial.mp4"/></asset><asset id="a37" name="S10_Deteccion_de_fallas_y_recuperacion" start="0s" duration="600/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S10_Deteccion_de_fallas_y_recuperacion.mp4"/></asset><asset id="a38" name="demo" start="0s" duration="2452/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/demo.mp4"/></asset><asset id="a39" name="S12_CARA_Hector" start="0s" duration="189/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/caras/S12_CARA_Hector.mp4"/></asset><asset id="a40" name="S13_Experimento__metodo" start="0s" duration="930/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S13_Experimento__metodo.mp4"/></asset><asset id="a41" name="S14_Experimento__resultados" start="0s" duration="780/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S14_Experimento__resultados.mp4"/></asset><asset id="a42" name="S15_Interoperabilidad" start="0s" duration="750/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S15_Interoperabilidad.mp4"/></asset><asset id="a43" name="S16_CARA_Camilo" start="0s" duration="489/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/caras/S16_CARA_Camilo.mp4"/></asset><asset id="a44" name="S17_Creditos" start="0s" duration="270/30s" hasVideo="1" hasAudio="0" format="r1" videoSources="1"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/render/escenas/S17_Creditos.mp4"/></asset></resources><library><event name="Video Chat Distribuido"><project name="Video sustentacion (FCPXML)"><sequence format="r1" duration="12721/30s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k"><spine><asset-clip ref="a28" offset="0/30s" duration="480/30s" start="0s" name="S01 Apertura"><marker start="0/30s" duration="1/30s" value="S01 Apertura" note="ANIM · Camilo: Cuatro grupos. Cuatro servidores. Una sola sala de chat para todo el curso. Pero, ¿qué le pasa a un mensaje cuando el servidor que lo debía recibir se apaga a mitad de camino?"/><asset-clip ref="a5" lane="-1" offset="18/30s" duration="342/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a29" offset="480/30s" duration="837/30s" start="0s" name="S02 Presentación y pregunta"><marker start="0/30s" duration="1/30s" value="S02 Presentación y pregunta" note="CARA · Camilo: Hola, somos Camilo, Johen, Daniel y Héctor, del curso de Sistemas Distribuidos de la UIS. Construimos el servidor de chat de nuestro grupo, que se conecta con el servidor central del profesor. Y nos hicimos una pregunta: si nuestro servidor se cae unos segundos, ¿cuántos mensajes se pierden o se repiten? Nuestra hipótesis: ninguno."/><asset-clip ref="a1" lane="1" offset="24/30s" duration="180/30s" start="0s" name="rotulo"/><asset-clip ref="a6" lane="-1" offset="18/30s" duration="635/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a30" offset="1317/30s" duration="1230/30s" start="0s" name="S03 Arquitectura en estrella"><marker start="0/30s" duration="1/30s" value="S03 Arquitectura en estrella" note="ANIM · Camilo: El sistema tiene forma de estrella. En el centro está el servidor del profesor y, alrededor, un servidor por cada grupo. Los grupos nunca se hablan directamente: todo pasa por el central. Cuando Ana escribe en ge a, su servidor envía el mensaje al central, el central lo guarda en su historial y lo reenvía a los demás grupos. Nuestro servidor es un contenedor de Docker con Python y FastAPI. Guarda todo en SQLite, dentro de un volumen que sobrevive a los reinicios, y se configura con variables de entorno: nada queda escrito en el código."/><asset-clip ref="a7" lane="-1" offset="18/30s" duration="945/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a31" offset="2547/30s" duration="216/30s" start="0s" name="S04 Johen entra"><marker start="0/30s" duration="1/30s" value="S04 Johen entra" note="CARA · Johen: Yo les explico qué pasa dentro de nuestro servidor cuando alguien escribe un mensaje."/><asset-clip ref="a2" lane="1" offset="24/30s" duration="180/30s" start="0s" name="rotulo"/><asset-clip ref="a8" lane="-1" offset="18/30s" duration="136/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a32" offset="2763/30s" duration="660/30s" start="0s" name="S05 Bandeja de salida"><marker start="0/30s" duration="1/30s" value="S05 Bandeja de salida" note="ANIM · Johen: Cuando alguien escribe, hacemos tres cosas en un solo paso, dentro de una transacción: subimos el reloj, guardamos el mensaje para mostrarlo y lo dejamos en una bandeja de salida. Si el servidor se muere justo después, el mensaje no se pierde: sigue en disco y se envía apenas vuelva."/><asset-clip ref="a9" lane="-1" offset="18/30s" duration="493/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a33" offset="3423/30s" duration="990/30s" start="0s" name="S06 Reloj de Lamport"><marker start="0/30s" duration="1/30s" value="S06 Reloj de Lamport" note="ANIM · Johen: Para ordenar los mensajes no usamos la hora, porque cada computador tiene su reloj un poco distinto. Usamos un reloj de Lamport, que es solo un contador. Al enviar, le sumamos uno. Al recibir, nos quedamos con el mayor entre el nuestro y el del mensaje, y le sumamos uno. Todos ordenan por ese número y, si hay empate, por el nombre del servidor. Así, todos los grupos ven exactamente el mismo orden."/><asset-clip ref="a10" lane="-1" offset="18/30s" duration="761/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a34" offset="4413/30s" duration="570/30s" start="0s" name="S07 Idempotencia"><marker start="0/30s" duration="1/30s" value="S07 Idempotencia" note="ANIM · Johen: Cada mensaje nace con un identificador único. Si nos llega uno que ya tenemos, respondemos que sí, pero no lo guardamos otra vez. Eso se llama idempotencia, y es la razón por la que reintentar nunca muestra mensajes repetidos."/><asset-clip ref="a11" lane="-1" offset="18/30s" duration="409/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a35" offset="4983/30s" duration="318/30s" start="0s" name="S08 Daniel entra"><marker start="0/30s" duration="1/30s" value="S08 Daniel entra" note="CARA · Daniel: Yo me encargué de la conexión con el servidor central: cómo enviamos, cómo reintentamos y cómo nos damos cuenta de que algo falló."/><asset-clip ref="a3" lane="1" offset="24/30s" duration="180/30s" start="0s" name="rotulo"/><asset-clip ref="a12" lane="-1" offset="18/30s" duration="218/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a36" offset="5301/30s" duration="960/30s" start="0s" name="S09 Reintentos con espera exponencial"><marker start="0/30s" duration="1/30s" value="S09 Reintentos con espera exponencial" note="ANIM · Daniel: Una tarea de fondo va vaciando la bandeja de salida. Si el central responde bien, listo. Si responde con un error suyo, o no responde, reintentamos esperando cada vez el doble: uno, dos, cuatro, ocho segundos, hasta treinta, con un poco de azar para que no reintenten todos a la vez. Si responde que el mensaje está mal, un error cuatrocientos, no insistimos y lo dejamos en el log."/><asset-clip ref="a13" lane="-1" offset="18/30s" duration="727/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a37" offset="6261/30s" duration="600/30s" start="0s" name="S10 Detección de fallas y recuperación"><marker start="0/30s" duration="1/30s" value="S10 Detección de fallas y recuperación" note="ANIM · Daniel: Cada tres segundos le preguntamos al central si está vivo. Si falla tres veces seguidas, lo damos por caído y los mensajes se acumulan en disco. Cuando vuelve, nos registramos de nuevo, pedimos con history todo lo que nos perdimos y enviamos lo pendiente."/><asset-clip ref="a14" lane="-1" offset="18/30s" duration="437/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a38" offset="6861/30s" duration="2452/30s" start="0s" name="S11 Demo: caída y recuperación"><marker start="0/30s" duration="1/30s" value="S11 Demo: caída y recuperación" note="DEMO · Daniel: Esta es la demo real. A la izquierda, el chat del grupo ge a; a la derecha, el de ge be. Abajo, los logs de los dos servidores. / Ana escribe desde ge a y Beto responde desde ge be. Cada mensaje lleva su número de Lamport. / Ahora apagamos ge a de golpe, con docker kill. / Beto sigue escribiendo. Esos mensajes llegan al central, pero ge a no está para recibirlos. / Prendemos ge a otra vez. En el log aparece history request, y un recovered por cada mensaje perdido. / Ahí están: todos los mensajes, una sola vez y en el mismo orden en los dos grupos. / Ahora apagamos el servidor central. Tras tres latidos fallidos, ge a lo marca como caído, y lo que escribe Ana queda pendiente en disco. / El central vuelve. ge a se registra otra vez, vacía la bandeja de salida, y Beto recibe los mensajes sin repetidos."/><asset-clip ref="a15" lane="-1" offset="9/30s" duration="275/30s" start="0s" name="voz guia"/><asset-clip ref="a16" lane="-1" offset="290/30s" duration="174/30s" start="0s" name="voz guia"/><asset-clip ref="a17" lane="-1" offset="568/30s" duration="96/30s" start="0s" name="voz guia"/><asset-clip ref="a18" lane="-1" offset="712/30s" duration="181/30s" start="0s" name="voz guia"/><asset-clip ref="a19" lane="-1" offset="1034/30s" duration="198/30s" start="0s" name="voz guia"/><asset-clip ref="a20" lane="-1" offset="1320/30s" duration="158/30s" start="0s" name="voz guia"/><asset-clip ref="a21" lane="-1" offset="1515/30s" duration="247/30s" start="0s" name="voz guia"/><asset-clip ref="a22" lane="-1" offset="2019/30s" duration="229/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a39" offset="9313/30s" duration="189/30s" start="0s" name="S12 Héctor entra"><marker start="0/30s" duration="1/30s" value="S12 Héctor entra" note="CARA · Héctor: Y yo les muestro el experimento con el que pusimos a prueba todo esto."/><asset-clip ref="a4" lane="1" offset="24/30s" duration="180/30s" start="0s" name="rotulo"/><asset-clip ref="a23" lane="-1" offset="18/30s" duration="114/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a40" offset="9502/30s" duration="930/30s" start="0s" name="S13 Experimento: método"><marker start="0/30s" duration="1/30s" value="S13 Experimento: método" note="ANIM · Héctor: Levantamos un central de prueba y dos servidores nuestros, ge a y ge be. ge be envía cinco mensajes por segundo. A los cuatro segundos apagamos ge a de golpe y lo prendemos tras dos, cinco o diez segundos. Además, el central pierde el diez por ciento de las respuestas y duplica el diez por ciento de los mensajes. Tres repeticiones de cada caso, con y sin pedir el historial: dieciocho corridas."/><asset-clip ref="a24" lane="-1" offset="18/30s" duration="699/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a41" offset="10432/30s" duration="780/30s" start="0s" name="S14 Experimento: resultados"><marker start="0/30s" duration="1/30s" value="S14 Experimento: resultados" note="ANIM · Héctor: Con recuperación: cero mensajes perdidos y cero repetidos en pantalla en las nueve corridas, aunque llegaron trescientos sesenta y tres duplicados reales que se descartaron por su identificador. ge a se pone al día en menos de un segundo y medio. Sin pedir el historial, las pérdidas crecen con la caída: con diez segundos se pierde el treinta y siete por ciento."/><asset-clip ref="a25" lane="-1" offset="18/30s" duration="583/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a42" offset="11212/30s" duration="750/30s" start="0s" name="S15 Interoperabilidad"><marker start="0/30s" duration="1/30s" value="S15 Interoperabilidad" note="ANIM · Daniel: También ensayamos la sesión de interoperabilidad con cuatro grupos: dos copias del nuestro y dos implementaciones escritas aparte, una correcta y otra con errores típicos. Todos recibieron todo. Pero la que tenía errores ordena por llegada, y ve otro orden; y como guarda en memoria, al reiniciarse pierde su historial."/><asset-clip ref="a26" lane="-1" offset="18/30s" duration="555/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a43" offset="11962/30s" duration="489/30s" start="0s" name="S16 Cierre"><marker start="0/30s" duration="1/30s" value="S16 Cierre" note="CARA · Camilo: En resumen: reintentar hasta que llegue y descartar los repetidos hace que cada mensaje se vea exactamente una vez. Y el reloj de Lamport le da a todos el mismo orden, sin un reloj común. Gracias."/><asset-clip ref="a27" lane="-1" offset="18/30s" duration="356/30s" start="0s" name="voz guia"/></asset-clip><asset-clip ref="a44" offset="12451/30s" duration="270/30s" start="0s" name="S17 Créditos"><marker start="0/30s" duration="1/30s" value="S17 Créditos" note="ANIM · : "/></asset-clip></spine></sequence></project></event></library></fcpxml>
