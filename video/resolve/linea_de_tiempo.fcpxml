audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S03.wav"/></asset><asset id="a8" name="S04" start="0s" duration="136/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S04.wav"/></asset><asset id="a9" name="S05" start="0s" duration="493/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S05.wav"/></asset><asset id="a10" name="S06" start="0s" duration="761/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S06.wav"/></asset><asset id="a11" name="S07" start="0s" duration="409/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S07.wav"/></asset><asset id="a12" name="S08" start="0s" duration="218/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S08.wav"/></asset><asset id="a13" name="S09" start="0s" duration="727/30s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000"><media-rep kind="original-media" src="file:///C:/Users/camil/Downloads/Proyecto%20Final%20Sistemas%20Distribuidos/chat-distribuido/video/tts/S09.wav"/></asset><asset id="a14" name