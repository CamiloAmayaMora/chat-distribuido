# --- Obligatorias -----------------------------------------------------------
# Nombre corto con el que nuestro servidor aparece en el chat (lo que diga el profesor; si no dice nada, este)
GROUP_NAME=amaya
# URL con la que el servidor central alcanza a ESTE servidor (IP del portátil en la red del salón)
PUBLIC_URL=http://192.168.0.50:8000
# URL del servidor central del curso (la publica el profesor)
CENTRAL_URL=http://192.168.0.10:9000

# --- Opcionales (valores por defecto) ---------------------------------------
HOST_PORT=8000
# s entre renovaciones del registro
REGISTER_INTERVAL=15
# s entre GET /health al central
HEARTBEAT_INTERVAL=3
# fallos seguidos para marcar al central como caído
HEARTBEAT_MAX_FAILURES=3
# s de timeout de cada petición
HTTP_TIMEOUT=3
# primera espera del backoff exponencial (s)
RETRY_BASE=1
# tope del backoff (s)
RETRY_MAX=30
# pedir GET /history al arrancar y al volver el central
HISTORY_RECOVERY=true
# marcas de Lamport de solapamiento al pedir /history (-1 = desde 0)
HISTORY_OVERLAP=100
# >0 activa sincronización periódica (modo pull / anti-entropía)
SYNC_POLL_INTERVAL=0
LOG_LEVEL=INFO
